# Copie a remplir : deploy/deploy.env (ignore par git). Chaque cle remplace
# le jeton __CLE__ dans les fichiers deployes (deploy/render.sh), et sert aux
# scripts de deploiement. Rien de ce fichier n'est cense apparaitre dans le
# depot : noms d'hote, chemins, comptes.

# Hote Docker qui fait tourner Home Assistant et le service (alias ssh).
HOST=nas
# Dossier de configuration de Home Assistant sur cet hote (monte en /config).
HA_CONFIG=/srv/homeassistant/config
# API de Home Assistant, vue depuis la machine qui deploie ($HA = jeton).
HA_API=http://192.0.2.10:8123
# Home Assistant vu depuis le reseau local, puis depuis l'exterieur (VPN).
# Les deux servent aux boutons « Photo » du tableau : URL absolues.
HA_URL_LAN=https://ha.example.lan
HA_URL_REMOTE=https://ha.example.ts.net
# Nom d'hote du serveur de photos du service (route Traefik).
PHOTOS_HOST=sonnette.example.lan
# Dossier du service sur l'hote : data/ (config.yaml, registre, journaux)
# et build/ (contexte de construction de l'image).
SERVICE_HOME=/srv/doorbell-ai
# Dossier des photos sur l'hote (monte en /photos dans le service).
PHOTOS_HOST_DIR=/srv/homeassistant/media/doorbell-ai
# Portainer : URL, pile et endpoint du service. $PORTAINER = cle d'API.
PORTAINER_URL=https://portainer.example.lan
STACK_ID=1
ENDPOINT_ID=1
# Cibles des notifications (integration mobile_app) : telephone, ordinateur.
NOTIFY_PHONE=notify.mobile_app_telephone
NOTIFY_LAPTOP=notify.mobile_app_ordinateur
