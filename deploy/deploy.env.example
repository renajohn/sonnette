# Copy to fill in: deploy/deploy.env (ignored by git). Each key replaces
# the __KEY__ token in the deployed files (deploy/render.sh), and is used by
# the deployment scripts. Nothing in this file is meant to appear in the
# repository: host names, paths, accounts.

# Docker host that runs Home Assistant and the service (ssh alias).
HOST=nas
# Home Assistant configuration folder on that host (mounted as /config).
HA_CONFIG=/srv/homeassistant/config
# Home Assistant API, as seen from the machine that deploys ($HA = token).
HA_API=http://192.0.2.10:8123
# Home Assistant as seen from the local network, then from outside (VPN).
# Both are used by the "Photo" buttons of the dashboard: absolute URLs.
HA_URL_LAN=https://ha.example.lan
HA_URL_REMOTE=https://ha.example.ts.net
# Host name of the photo server of the service (Traefik route).
PHOTOS_HOST=sonnette.example.lan
# Service folder on the host: data/ (config.yaml, registry, journals)
# and build/ (image build context).
SERVICE_HOME=/srv/doorbell-ai
# Photos folder on the host (mounted as /photos in the service).
PHOTOS_HOST_DIR=/srv/homeassistant/media/doorbell-ai
# Portainer: URL, stack and endpoint of the service. $PORTAINER = API key.
PORTAINER_URL=https://portainer.example.lan
STACK_ID=1
ENDPOINT_ID=1
# Notification targets (mobile_app integration): phone, laptop.
NOTIFY_PHONE=notify.mobile_app_telephone
NOTIFY_LAPTOP=notify.mobile_app_ordinateur
